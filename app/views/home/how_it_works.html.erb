<div class="page-header text-center">
  <h1 class="page-title">كيف يعمل السوق السوري</h1>
  <p class="page-description">دليل سريع لاستخدام المنصة</p>
</div>

<!-- Steps for Buyers -->
<h2 class="section-title text-center mb-4">للمشترين</h2>
<div class="row g-4 mb-5">
  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">١</div>
      <div class="step-icon">
        <i class="fas fa-search fa-3x" style="color: #CE1126;"></i>
      </div>
      <h4>ابحث</h4>
      <p class="text-muted">ابحث عن المنتج أو الخدمة التي تريدها باستخدام كلمات مفتاحية أو تصفح الأقسام</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">٢</div>
      <div class="step-icon">
        <i class="fas fa-filter fa-3x" style="color: #007A3D;"></i>
      </div>
      <h4>صفِّ</h4>
      <p class="text-muted">استخدم الفلاتر لتحديد السعر، المدينة، الحالة، ونوع الإعلان</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">٣</div>
      <div class="step-icon">
        <i class="fas fa-comments fa-3x" style="color: #CE1126;"></i>
      </div>
      <h4>تواصل</h4>
      <p class="text-muted">تواصل مع البائع عبر الرسائل أو الواتساب للاستفسار</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">٤</div>
      <div class="step-icon">
        <i class="fas fa-handshake fa-3x" style="color: #007A3D;"></i>
      </div>
      <h4>اشترِ</h4>
      <p class="text-muted">اتفق مع البائع على طريقة الدفع والتسليم وأتم الصفقة</p>
    </div>
  </div>
</div>

<!-- Steps for Sellers -->
<h2 class="section-title text-center mb-4">للبائعين</h2>
<div class="row g-4 mb-5">
  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">١</div>
      <div class="step-icon">
        <i class="fas fa-user-plus fa-3x" style="color: #CE1126;"></i>
      </div>
      <h4>سجل</h4>
      <p class="text-muted">أنشئ حساباً مجانياً على المنصة</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">٢</div>
      <div class="step-icon">
        <i class="fas fa-plus-circle fa-3x" style="color: #007A3D;"></i>
      </div>
      <h4>أضف إعلان</h4>
      <p class="text-muted">انقر على "إعلان جديد" وأضف تفاصيل المنتج أو الخدمة</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">٣</div>
      <div class="step-icon">
        <i class="fas fa-images fa-3x" style="color: #CE1126;"></i>
      </div>
      <h4>أضف صوراً</h4>
      <p class="text-muted">الصور الجيدة تزيد فرص البيع - أضف صوراً واضحة للمنتج</p>
    </div>
  </div>

  <div class="col-md-3">
    <div class="step-card">
      <div class="step-number">٤</div>
      <div class="step-icon">
        <i class="fas fa-check-circle fa-3x" style="color: #007A3D;"></i>
      </div>
      <h4>انتظر المشترين</h4>
      <p class="text-muted">بعد النشر، سيتمكن المشترون من رؤية إعلانك والتواصل معك</p>
    </div>
  </div>
</div>

<!-- Steps for Job Seekers -->
<h2 class="section-title text-center mb-4">للباحثين عن عمل</h2>
<div class="row g-4 mb-5">
  <div class="col-md-4">
    <div class="step-card">
      <div class="step-number">١</div>
      <div class="step-icon">
        <i class="fas fa-briefcase fa-3x" style="color: #CE1126;"></i>
      </div>
      <h4>تصفح الوظائف</h4>
      <p class="text-muted">اذهب إلى قسم "وظائف" وتصفح الفرص المتاحة</p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="step-card">
      <div class="step-number">٢</div>
      <div class="step-icon">
        <i class="fas fa-file-alt fa-3x" style="color: #007A3D;"></i>
      </div>
      <h4>قدم طلبك</h4>
      <p class="text-muted">انقر على "التقديم للوظيفة" واملأ المعلومات المطلوبة</p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="step-card">
      <div class="step-number">٣</div>
      <div class="step-icon">
        <i class="fab fa-whatsapp fa-3x" style="color: #CE1126;"></i>
      </div>
      <h4>تواصل مع صاحب العمل</h4>
      <p class="text-muted">بعد التقديم، يمكنك التواصل مع صاحب العمل عبر الواتساب</p>
    </div>
  </div>
</div>

<!-- Features -->
<h2 class="section-title text-center mb-4">مميزات المنصة</h2>
<div class="row g-4 mb-5">
  <div class="col-md-4">
    <div class="feature-card">
      <i class="fas fa-shield-alt fa-3x mb-3" style="color: #CE1126;"></i>
      <h4>آمن وموثوق</h4>
      <p>نحن نتحقق من الإعلانات ونوفر بيئة آمنة للمستخدمين</p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="feature-card">
      <i class="fas fa-clock fa-3x mb-3" style="color: #007A3D;"></i>
      <h4>سهل الاستخدام</h4>
      <p>واجهة بسيطة تمكنك من نشر إعلان في دقائق</p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="feature-card">
      <i class="fas fa-mobile-alt fa-3x mb-3" style="color: #CE1126;"></i>
      <h4>متوافق مع الجوال</h4>
      <p>يمكنك استخدام المنصة من أي جهاز - جوال، تابلت، أو كمبيوتر</p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="feature-card">
      <i class="fas fa-whatsapp fa-3x mb-3" style="color: #007A3D;"></i>
      <h4>تواصل مباشر</h4>
      <p>تواصل مع البائعين والمشترين عبر الواتساب بنقرة واحدة</p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="feature-card">
      <i class="fas fa-heart fa-3x mb-3" style="color: #CE1126;"></i>
      <h4>إعلانات مفضلة</h4>
      <p>احفظ الإعلانات التي تعجبك في قائمة المفضلة للرجوع إليها لاحقاً</p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="feature-card">
      <i class="fas fa-chart-line fa-3x mb-3" style="color: #007A3D;"></i>
      <h4>إحصائيات</h4>
      <p>تابع عدد مشاهدات إعلاناتك في لوحة التحكم</p>
    </div>
  </div>
</div>

<!-- FAQ -->
<h2 class="section-title text-center mb-4">أسئلة شائعة</h2>
<div class="accordion mb-5" id="faqAccordion">
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
        هل المنصة مجانية؟
      </button>
    </h2>
    <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
      <div class="accordion-body">
        نعم، التسجيل ونشر الإعلانات الأساسية مجاني بالكامل. قد نضيف في المستقبل خدمات مدفوعة مثل الإعلانات المميزة.
      </div>
    </div>
  </div>

  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
        كيف يمكنني حذف إعلاني؟
      </button>
    </h2>
    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
      <div class="accordion-body">
        يمكنك حذف إعلانك من خلال الدخول إلى "إعلاناتي" في لوحة التحكم، ثم الضغط على أيقونة الحذف بجانب الإعلان.
      </div>
    </div>
  </div>

  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
        كيف يمكنني التواصل مع البائع؟
      </button>
    </h2>
    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
      <div class="accordion-body">
        يمكنك التواصل مع البائع عبر إرسال رسالة داخلية من المنصة، أو عبر الواتساب إذا كان البائع قد فعّل هذه الخاصية.
      </div>
    </div>
  </div>

  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
        ماذا أفعل إذا واجهت مشكلة مع بائع؟
      </button>
    </h2>
    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
      <div class="accordion-body">
        ننصح أولاً بمحاولة حل المشكلة ودياً. إذا لم تنجح، يمكنك الاتصال بفريق الدعم عبر صفحة "اتصل بنا" وسنحاول المساعدة في حدود إمكانياتنا.
      </div>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-section text-center p-5 rounded">
  <h2 class="text-white mb-3">ابدأ الآن!</h2>
  <p class="text-white mb-4">انضم إلى آلاف المستخدمين واستفد من خدمات المنصة</p>
  <% if user_signed_in? %>
    <%= link_to new_listing_path, class: 'btn btn-light btn-lg' do %>
      <i class="fas fa-plus"></i> أضف إعلانك الأول
    <% end %>
  <% else %>
    <%= link_to new_user_registration_path, class: 'btn btn-light btn-lg' do %>
      <i class="fas fa-user-plus"></i> سجل مجاناً
    <% end %>
  <% end %>
</div>
