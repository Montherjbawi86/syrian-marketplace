<!-- Hero Section with Search Filters -->
<section class="hero-section">

  <div class="hero-content">
    <h1 class="hero-title">السوق السوري</h1>
    <p class="hero-subtitle">أكبر منصة للبيع والشراء والتوظيف في سوريا</p>

    <!-- Search Form with Filters (Rails form) -->
    <%= form_tag search_path, method: :get, class: 'hero-search-form', id: 'mainSearchForm' do %>
      <!-- Main Search Input with suggestions wrapper -->
      <div class="input-group mb-3" style="position: relative;">
        <%= text_field_tag :q, params[:q], class: 'form-control hero-search-input', id: 'searchInput', placeholder: 'ابحث عن...', autocomplete: 'off' %>
        <button class="btn hero-search-btn" type="submit" id="searchBtn">
          <i class="fas fa-search"></i> بحث
        </button>
        <div id="suggestionsBox" class="search-suggestions"></div>
      </div>

      <!-- Filter Row (with floating label wrappers) -->
      <div class="row g-3">
        <div class="col-md-4">
          <div class="floating-wrapper">
            <%= select_tag :category_id,
                options_from_collection_for_select(@categories, :id, :name_ar, params[:category_id]),
                prompt: 'جميع الأقسام',
                class: 'form-select',
                id: 'categorySelect' %>
            <label class="floating-label">القسم</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="floating-wrapper">
            <%= select_tag :city_id,
                options_from_collection_for_select(@cities, :id, :name_ar, params[:city_id]),
                prompt: 'جميع المدن',
                class: 'form-select',
                id: 'citySelect' %>
            <label class="floating-label">المدينة</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="floating-wrapper">
            <%= select_tag :listing_type,
                options_for_select([
                  ['جميع الأنواع', ''],
                  ['للبيع', 'sell'],
                  ['للإيجار', 'rent'],
                  ['مطلوب', 'wanted'],
                  ['وظيفة', 'job']
                ], params[:listing_type]),
                class: 'form-select',
                id: 'typeSelect' %>
            <label class="floating-label">النوع</label>
          </div>
        </div>
      </div>

      <!-- Advanced Filters (collapsible) -->
      <button type="button" class="toggle-filters mt-2" id="toggleAdvancedBtn">
        <i class="fas fa-sliders-h"></i> خيارات متقدمة
      </button>
      <div class="row g-3 mt-2" id="advancedFilters" style="display: none;">
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text" style="color: white;">السعر من</span>
            <%= number_field_tag :min_price, params[:min_price], class: "form-control", placeholder: "الحد الأدنى", step: 1000, id: "minPrice" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text" style="color: white;">السعر إلى</span>
            <%= number_field_tag :max_price, params[:max_price], class: "form-control", placeholder: "الحد الأعلى", step: 1000, id: "maxPrice" %>
          </div>
        </div>
      </div>

      <!-- Reset Filter Link -->
      <div class="text-center mt-4">
        <%= link_to "إعادة تعيين", root_path, class: "reset-link text-decoration-none small", style: "color:#CE1126;" %>
      </div>
    <% end %>
  </div>
</section>

<!-- Categories Section (unchanged) -->
<div class="section-header">
  <h2 class="section-title"><i class="fas fa-th-large section-icon"></i> الأقسام الرئيسية</h2>
  <%= link_to 'عرض الكل', categories_path, class: 'btn btn-outline-primary view-all-btn' %>
</div>

<div class="row g-4 categories-grid">
  <% @categories.each do |category| %>
    <div class="col-md-3 col-6">
      <%= link_to category_path(category), class: 'category-link' do %>
        <div class="card category-card">
          <div class="card-body category-card-body">
            <i class="fas <%= category.icon %> category-icon"></i>
            <h5 class="category-name"><%= category.name_ar %></h5>
            <span class="badge category-count"><%= category.listings.count %> إعلان</span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<!-- For Sale & For Rent Sections -->
<div class="row listings-sections">
  <div class="col-md-6 mb-4">
    <div class="card">
   <div class="card-header section-header">
   <h5 class="mb-0"><i class="fas fa-tag ms-2" style="color: black;"></i> للبيع</h5>
    <%= link_to 'المزيد', for_sale_listings_path, class: 'btn btn-sm section-more-btn', style: "color: white; background: green; border: 1px solid #ccc;" %>
</div>
      <div class="card-body">
        <div class="list-group list-group-flush">
          <% @for_sale.each do |listing| %>
            <%= link_to listing_path(listing), class: 'list-group-item listing-item' do %>
              <div class="listing-item-content">
                <h6 class="listing-item-title"><%= listing.title_ar.truncate(30) %></h6>
                <small class="listing-item-location"><i class="fas fa-map-marker-alt location-icon"></i> <%= listing.city&.name_ar %></small>
              </div>
              <span class="listing-item-price"><%= number_to_currency(listing.price, unit: "ل.س", format: "%u %n", precision: 0) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 mb-4">
    <div class="card">
      <div class="card-header section-header">
        <h5 class="mb-0"><i class="fas fa-key ms-2" style="color: black;"></i>للإيجار</h5>
        <%= link_to 'المزيد', for_rent_listings_path, class: 'btn btn-sm section-more-btn', style: "color: white; background: green; border: 1px solid #ccc;" %>
      </div>
      <div class="card-body">
        <div class="list-group list-group-flush">
          <% @for_rent.each do |listing| %>
            <%= link_to listing_path(listing), class: 'list-group-item listing-item' do %>
              <div class="listing-item-content">
                <h6 class="listing-item-title"><%= listing.title_ar.truncate(30) %></h6>
                <small class="listing-item-location"><i class="fas fa-map-marker-alt location-icon"></i> <%= listing.city&.name_ar %></small>
              </div>
              <span class="listing-item-price"><%= number_to_currency(listing.price, unit: "ل.س", format: "%u %n", precision: 0) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Listings -->
<div class="section-header">
  <h2 class="section-title"><i class="fas fa-clock section-icon"></i> أحدث الإعلانات</h2>
  <%= link_to 'عرض الكل', listings_path, class: 'btn btn-outline-primary view-all-btn' %>
</div>

<div class="row g-4 recent-listings">
  <%= render partial: 'listings/listing_card', collection: @recent_listings, as: :listing %>
</div>

<!-- Cities Section -->
<div class="section-header">
  <h2 class="section-title"><i class="fas fa-city section-icon"></i> المدن</h2>
  <%= link_to 'عرض الكل', cities_path, class: 'btn btn-outline-primary view-all-btn' %>
</div>

<div class="row g-3 cities-grid">
  <% @cities.each do |city| %>
    <div class="col-md-2 col-4">
      <%= link_to city_path(city), class: 'city-link' do %>
        <div class="card city-card">
          <div class="card-body city-card-body">
            <i class="fas fa-city city-icon"></i>
            <h6 class="city-name"><%= city.name_ar %></h6>
            <small class="city-count"><%= city.listings.count %> إعلان</small>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

