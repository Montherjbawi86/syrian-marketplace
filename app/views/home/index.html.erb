<!-- Hero Section with Search Filters -->
<section class="hero-section">

  <div class="hero-content">
    <h1 class="hero-title">السوق السوري</h1>
    <p class="hero-subtitle">أكبر منصة للبيع والشراء والتوظيف في سوريا</p>

    <!-- Search Form with Filters (Rails form) -->
    <%= form_tag search_path, method: :get, class: 'hero-search-form', id: 'mainSearchForm' do %>
      <!-- Main Search Input with suggestions wrapper -->
      <div class="input-group mb-3" style="position: relative;">
        <%= text_field_tag :q, params[:q], class: 'form-control hero-search-input', id: 'searchInput', placeholder: 'ابحث عن...', autocomplete: 'off' %>
        <button class="btn hero-search-btn" type="submit" id="searchBtn">
          <i class="fas fa-search"></i> بحث
        </button>
        <div id="suggestionsBox" class="search-suggestions"></div>
      </div>

      <!-- Filter Row (with floating label wrappers) -->
      <div class="row g-3">
        <div class="col-md-4">
          <div class="floating-wrapper">
            <%= select_tag :category_id,
                options_from_collection_for_select(@categories, :id, :name_ar, params[:category_id]),
                prompt: 'جميع الأقسام',
                class: 'form-select',
                id: 'categorySelect' %>
            <label class="floating-label">القسم</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="floating-wrapper">
            <%= select_tag :city_id,
                options_from_collection_for_select(@cities, :id, :name_ar, params[:city_id]),
                prompt: 'جميع المدن',
                class: 'form-select',
                id: 'citySelect' %>
            <label class="floating-label">المدينة</label>
          </div>
        </div>
        <div class="col-md-4">
          <div class="floating-wrapper">
            <%= select_tag :listing_type,
                options_for_select([
                  ['جميع الأنواع', ''],
                  ['للبيع', 'sell'],
                  ['للإيجار', 'rent'],
                  ['مطلوب', 'wanted'],
                  ['وظيفة', 'job']
                ], params[:listing_type]),
                class: 'form-select',
                id: 'typeSelect' %>
            <label class="floating-label">النوع</label>
          </div>
        </div>
      </div>

      <!-- Advanced Filters (collapsible) -->
      <button type="button" class="toggle-filters mt-2" id="toggleAdvancedBtn">
        <i class="fas fa-sliders-h"></i> خيارات متقدمة
      </button>
      <div class="row g-3 mt-2" id="advancedFilters" style="display: none;">
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text" style="color: white;">السعر من</span>
            <%= number_field_tag :min_price, params[:min_price], class: "form-control", placeholder: "الحد الأدنى", step: 1000, id: "minPrice" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="input-group">
            <span class="input-group-text" style="color: white;">السعر إلى</span>
            <%= number_field_tag :max_price, params[:max_price], class: "form-control", placeholder: "الحد الأعلى", step: 1000, id: "maxPrice" %>
          </div>
        </div>
      </div>

      <!-- Reset Filter Link -->
      <div class="text-center mt-4">
        <%= link_to "إعادة تعيين", root_path, class: "reset-link text-decoration-none small", style: "color:#CE1126;" %>
      </div>
    <% end %>
  </div>
</section>

<!-- Categories Section -->
<div class="section-header" style="border-right: none; padding-right: 0;">
  <h2 class="section-title"><i class="fas fa-th-large section-icon"></i> الأقسام الرئيسية</h2>
  <%= link_to 'عرض الكل', categories_path, class: 'btn btn-outline-primary view-all-btn' %>
</div>

<div class="row g-4 categories-grid">
  <% @categories.each do |category| %>
    <div class="col-md-3 col-6">
      <%= link_to category_path(category), class: 'category-link', style: 'text-decoration: none;' do %>
        <div class="card category-card">
          <div class="card-body category-card-body">
            <i class="fas <%= category.icon %> category-icon"></i>
            <h5 class="category-name"><%= category.name_ar %></h5>
            <span class="badge category-count"><%= category.listings.count %> إعلان</span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
<!-- For Sale & For Rent Sections -->
<div class="row listings-sections">
  <div class="col-md-6 mb-4">
    <div class="card">
      <div class="card-header section-header">
        <h5 class="mb-0"><i class="fas fa-tag ms-2" style="color: black;"></i> للبيع</h5>
        <%= link_to 'المزيد للبيع', for_sale_listings_path, class: 'btn btn-sm section-more-btn', style: "color: white; background: green; border: 1px solid #ccc;" %>
      </div>
      <div class="card-body">
        <div class="list-group list-group-flush">
          <% @for_sale.each do |listing| %>
            <%= link_to listing_path(listing), class: 'list-group-item listing-item' do %>
              <div class="listing-item-content">
                <!-- Show category name as title instead of listing title -->
                <h6 class="listing-item-title">
                  <%= listing.category&.name_ar || listing.title_ar.truncate(30) %>
                </h6>
                <small class="listing-item-location">
                  <i class="fas fa-map-marker-alt location-icon"></i>
                  <%= listing.city&.name_ar %>
                </small>
              </div>
              <span class="listing-item-price">
                <%= number_to_currency(listing.price, unit: "ل.س", format: "%u %n", precision: 0) %>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 mb-4">
    <div class="card">
      <div class="card-header section-header">
        <h5 class="mb-0"><i class="fas fa-key ms-2" style="color: black;"></i> للإيجار</h5>
        <%= link_to 'المزيد للايجار', for_rent_listings_path, class: 'btn btn-sm section-more-btn', style: "color: white; background: green; border: 1px solid #ccc;" %>
      </div>
      <div class="card-body">
        <div class="list-group list-group-flush">
          <% @for_rent.each do |listing| %>
            <%= link_to listing_path(listing), class: 'list-group-item listing-item' do %>
              <div class="listing-item-content">
                <!-- Show category name as title instead of listing title -->
                <h6 class="listing-item-title">
                  <%= listing.category&.name_ar || listing.title_ar.truncate(30) %>
                </h6>
                <small class="listing-item-location">
                  <i class="fas fa-map-marker-alt location-icon"></i>
                  <%= listing.city&.name_ar %>
                </small>
              </div>
              <span class="listing-item-price">
                <%= number_to_currency(listing.price, unit: "ل.س", format: "%u %n", precision: 0) %>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Listings -->
<div class="section-header">
  <h2 class="section-title"><i class="fas fa-clock section-icon"></i> أحدث الإعلانات</h2>
  <%= link_to 'عرض الكل', listings_path, class: 'btn btn-outline-primary view-all-btn' %>
</div>

<div class="row g-4 recent-listings">
  <%= render partial: 'listings/listing_card', collection: @recent_listings, as: :listing %>
</div>

<!-- Cities Section -->
<div class="section-header">
  <h2 class="section-title"><i class="fas fa-city section-icon"></i> المدن</h2>
  <%= link_to 'عرض الكل', cities_path, class: 'btn btn-outline-primary view-all-btn' %>
</div>

<div class="row g-3 cities-grid">
  <% @cities.each do |city| %>
    <div class="col-md-2 col-4">
      <%= link_to city_path(city), class: 'city-link' do %>
        <div class="card city-card">
          <div class="card-body city-card-body">
            <i class="fas fa-city city-icon"></i>
            <h6 class="city-name"><%= city.name_ar %></h6>
            <small class="city-count"><%= city.listings.count %> إعلان</small>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>



<script>
  // Scroll reveal animation
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('revealed');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.scroll-reveal').forEach(el => {
    observer.observe(el);
  });

  // Add floating particles to hero
  function addFloatingParticles() {
    const heroSection = document.querySelector('.hero-section');
    if (heroSection) {
      for (let i = 0; i < 20; i++) {
        const particle = document.createElement('div');
        particle.className = 'floating-particle';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.top = Math.random() * 100 + '%';
        particle.style.animationDelay = Math.random() * 8 + 's';
        particle.style.animationDuration = 5 + Math.random() * 7 + 's';
        particle.style.width = (2 + Math.random() * 5) + 'px';
        particle.style.height = particle.style.width;
        heroSection.appendChild(particle);
      }
    }
  }
  addFloatingParticles();

  (function() {
    // ========== DOM elements ==========
    const searchForm = document.getElementById('mainSearchForm');
    const searchInput = document.getElementById('searchInput');
    const searchBtn = document.getElementById('searchBtn');
    const suggestionsBox = document.getElementById('suggestionsBox');
    const toggleBtn = document.getElementById('toggleAdvancedBtn');
    const advancedFilters = document.getElementById('advancedFilters');
    const resetLink = document.querySelector('.reset-link');
    const categorySelect = document.getElementById('categorySelect');
    const citySelect = document.getElementById('citySelect');
    const typeSelect = document.getElementById('typeSelect');
    const minPrice = document.getElementById('minPrice');
    const maxPrice = document.getElementById('maxPrice');

    // ========== 1. Typewriter placeholder ==========
    const phrases = ['ابحث عن...', 'شقة للبيع', 'سيارة مستعملة', 'وظيفة محاسب', 'جهاز لابتوب'];
    let phraseIdx = 0, charIdx = 0, isDeleting = false;

    function typePlaceholder() {
      const current = phrases[phraseIdx];
      if (isDeleting) {
        searchInput.placeholder = current.substring(0, charIdx - 1);
        charIdx--;
      } else {
        searchInput.placeholder = current.substring(0, charIdx + 1);
        charIdx++;
      }
      if (!isDeleting && charIdx === current.length) {
        isDeleting = true;
        setTimeout(typePlaceholder, 2000);
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        setTimeout(typePlaceholder, 400);
      } else {
        setTimeout(typePlaceholder, isDeleting ? 40 : 90);
      }
    }
    typePlaceholder();

    // ========== 2. Live suggestions ==========
    const mockSuggestions = ['شقة في دمشق', 'سيارة مرسيدس', 'وظيفة مبرمج', 'أرض للبيع', 'غرفة للإيجار', 'أثاث منزلي', 'جهاز تلفاز'];

    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.trim();
      if (query.length < 1) {
        suggestionsBox.style.display = 'none';
        return;
      }
      const filtered = mockSuggestions.filter(s => s.includes(query));
      if (filtered.length) {
        suggestionsBox.innerHTML = filtered.map(s => `<div class="suggestion-item">${s}</div>`).join('');
        suggestionsBox.style.display = 'block';
      } else {
        suggestionsBox.style.display = 'none';
      }
    });

    suggestionsBox.addEventListener('click', (e) => {
      const item = e.target.closest('.suggestion-item');
      if (item) {
        searchInput.value = item.innerText;
        suggestionsBox.style.display = 'none';
      }
    });

    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
        suggestionsBox.style.display = 'none';
      }
    });

    // ========== 3. Loading state on submit ==========
    searchForm.addEventListener('submit', function(e) {
      const originalHtml = searchBtn.innerHTML;
      searchBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري البحث...';
      searchBtn.disabled = true;
      setTimeout(() => {
        if (searchBtn.disabled) {
          searchBtn.innerHTML = originalHtml;
          searchBtn.disabled = false;
        }
      }, 3000);
    });

    // ========== 4. Toggle advanced filters ==========
    if (toggleBtn && advancedFilters) {
      toggleBtn.addEventListener('click', () => {
        if (advancedFilters.style.display === 'none') {
          advancedFilters.style.display = 'flex';
          toggleBtn.innerHTML = '<i class="fas fa-chevron-up"></i> إخفاء الخيارات';
        } else {
          advancedFilters.style.display = 'none';
          toggleBtn.innerHTML = '<i class="fas fa-sliders-h"></i> خيارات متقدمة';
        }
      });
    }

    // ========== 5. Focus glow on search form ==========
    const formCard = document.querySelector('.hero-search-form');
    searchInput.addEventListener('focus', () => formCard.classList.add('focused'));
    searchInput.addEventListener('blur', () => formCard.classList.remove('focused'));

    // ========== 6. Floating labels initialization ==========
    function initFloatingLabels() {
      document.querySelectorAll('.floating-wrapper select, .floating-wrapper input').forEach(field => {
        const wrapper = field.closest('.floating-wrapper');
        const label = wrapper.querySelector('.floating-label');
        if (!label) return;
        const update = () => {
          if (field.value && field.value !== '') label.classList.add('active');
          else label.classList.remove('active');
        };
        field.addEventListener('change', update);
        field.addEventListener('focus', () => label.classList.add('active'));
        field.addEventListener('blur', update);
        update();
      });
    }
    initFloatingLabels();

    // ========== 7. Active filter tags ==========
    const tagsContainer = document.createElement('div');
    tagsContainer.id = 'filterTagsContainer';
    tagsContainer.className = 'active-filters-tags';
    const heroSection = document.querySelector('.hero-section');
    heroSection.insertAdjacentElement('afterend', tagsContainer);

    function updateFilterTags() {
      const filters = [];
      if (categorySelect.value) {
        const text = categorySelect.options[categorySelect.selectedIndex]?.text;
        if (text && text !== 'جميع الأقسام') filters.push({name: 'القسم', val: text});
      }
      if (citySelect.value) {
        const text = citySelect.options[citySelect.selectedIndex]?.text;
        if (text && text !== 'جميع المدن') filters.push({name: 'المدينة', val: text});
      }
      if (typeSelect.value) {
        const text = typeSelect.options[typeSelect.selectedIndex]?.text;
        if (text && text !== 'جميع الأنواع') filters.push({name: 'النوع', val: text});
      }
      if (minPrice.value) filters.push({name: 'السعر من', val: minPrice.value});
      if (maxPrice.value) filters.push({name: 'السعر إلى', val: maxPrice.value});

      if (filters.length === 0) {
        tagsContainer.innerHTML = '';
        return;
      }

      tagsContainer.innerHTML = filters.map(f => `
        <span class="filter-tag">
          ${f.name}: ${f.val}
          <i class="fas fa-times" data-filter="${f.name}"></i>
        </span>
      `).join('');

      document.querySelectorAll('#filterTagsContainer .filter-tag i').forEach(icon => {
        icon.addEventListener('click', (e) => {
          const filterName = icon.getAttribute('data-filter');
          if (filterName === 'القسم') categorySelect.value = '';
          if (filterName === 'المدينة') citySelect.value = '';
          if (filterName === 'النوع') typeSelect.value = '';
          if (filterName === 'السعر من') minPrice.value = '';
          if (filterName === 'السعر إلى') maxPrice.value = '';
          updateFilterTags();
        });
      });
    }

    [categorySelect, citySelect, typeSelect, minPrice, maxPrice].forEach(el => {
      if (el) el.addEventListener('change', updateFilterTags);
    });
    updateFilterTags();

    // ========== 8. Reset all filters ==========
    if (resetLink) {
      resetLink.addEventListener('click', (e) => {
        e.preventDefault();
        searchInput.value = '';
        categorySelect.value = '';
        citySelect.value = '';
        typeSelect.value = '';
        if (minPrice) minPrice.value = '';
        if (maxPrice) maxPrice.value = '';

        [categorySelect, citySelect, typeSelect, minPrice, maxPrice].forEach(f => {
          if (f) {
            const ev = new Event('change');
            f.dispatchEvent(ev);
          }
        });

        updateFilterTags();
        if (advancedFilters) advancedFilters.style.display = 'none';
        if (toggleBtn) toggleBtn.innerHTML = '<i class="fas fa-sliders-h"></i> خيارات متقدمة';
        searchForm.submit();
      });
    }
  })();
</script>
