<script>
  // Scroll reveal animation
const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
        }
    });
}, { threshold: 0.1 });

document.querySelectorAll('.scroll-reveal').forEach(el => {
    observer.observe(el);
});

// Add floating particles to hero
function addFloatingParticles() {
    const heroSection = document.querySelector('.hero-section');
    if (heroSection) {
        for (let i = 0; i < 20; i++) {
            const particle = document.createElement('div');
            particle.className = 'floating-particle';
            particle.style.left = Math.random() * 100 + '%';
            particle.style.top = Math.random() * 100 + '%';
            particle.style.animationDelay = Math.random() * 8 + 's';
            particle.style.animationDuration = 5 + Math.random() * 7 + 's';
            particle.style.width = (2 + Math.random() * 5) + 'px';
            particle.style.height = particle.style.width;
            heroSection.appendChild(particle);
        }
    }
}
addFloatingParticles();
  (function() {
    // ========== DOM elements ==========
    const searchForm = document.getElementById('mainSearchForm');
    const searchInput = document.getElementById('searchInput');
    const searchBtn = document.getElementById('searchBtn');
    const suggestionsBox = document.getElementById('suggestionsBox');
    const toggleBtn = document.getElementById('toggleAdvancedBtn');
    const advancedFilters = document.getElementById('advancedFilters');
    const resetLink = document.querySelector('.reset-link');
    const categorySelect = document.getElementById('categorySelect');
    const citySelect = document.getElementById('citySelect');
    const typeSelect = document.getElementById('typeSelect');
    const minPrice = document.getElementById('minPrice');
    const maxPrice = document.getElementById('maxPrice');

    // ========== 1. Typewriter placeholder ==========
    const phrases = ['ابحث عن...', 'شقة للبيع', 'سيارة مستعملة', 'وظيفة محاسب', 'جهاز لابتوب'];
    let phraseIdx = 0, charIdx = 0, isDeleting = false;
    function typePlaceholder() {
      const current = phrases[phraseIdx];
      if (isDeleting) {
        searchInput.placeholder = current.substring(0, charIdx - 1);
        charIdx--;
      } else {
        searchInput.placeholder = current.substring(0, charIdx + 1);
        charIdx++;
      }
      if (!isDeleting && charIdx === current.length) {
        isDeleting = true;
        setTimeout(typePlaceholder, 2000);
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        setTimeout(typePlaceholder, 400);
      } else {
        setTimeout(typePlaceholder, isDeleting ? 40 : 90);
      }
    }
    typePlaceholder();

    // ========== 2. Live suggestions (AJAX ready) ==========
    // You can replace the mock data with a real fetch to your listings#suggestions endpoint
    const mockSuggestions = ['شقة في دمشق', 'سيارة مرسيدس', 'وظيفة مبرمج', 'أرض للبيع', 'غرفة للإيجار', 'أثاث منزلي', 'جهاز تلفاز'];
    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.trim();
      if (query.length < 1) {
        suggestionsBox.style.display = 'none';
        return;
      }
      // Replace with real AJAX if needed:
      // fetch(`/listings/suggestions?q=${encodeURIComponent(query)}`)
      //   .then(r => r.json()).then(data => { ... })
      const filtered = mockSuggestions.filter(s => s.includes(query));
      if (filtered.length) {
        suggestionsBox.innerHTML = filtered.map(s => `<div class="suggestion-item">${s}</div>`).join('');
        suggestionsBox.style.display = 'block';
      } else {
        suggestionsBox.style.display = 'none';
      }
    });
    suggestionsBox.addEventListener('click', (e) => {
      const item = e.target.closest('.suggestion-item');
      if (item) {
        searchInput.value = item.innerText;
        suggestionsBox.style.display = 'none';
      }
    });
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
        suggestionsBox.style.display = 'none';
      }
    });

    // ========== 3. Loading state & ripple on submit ==========
    searchForm.addEventListener('submit', function(e) {
      // Do not prevent default – let Rails submit normally.
      // But we show loading state on button.
      const originalHtml = searchBtn.innerHTML;
      searchBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري البحث...';
      searchBtn.disabled = true;
      // Re-enable after a short delay (in case the form takes time)
      setTimeout(() => {
        if (searchBtn.disabled) {
          searchBtn.innerHTML = originalHtml;
          searchBtn.disabled = false;
        }
      }, 3000);
      // The form will submit naturally, but if you want to prevent double submission:
      // e.target.submit() will still work with disabled button? We'll let it go.
      // No e.preventDefault() here – keep Rails behavior.
    });

    // ========== 4. Toggle advanced filters ==========
    if (toggleBtn && advancedFilters) {
      toggleBtn.addEventListener('click', () => {
        if (advancedFilters.style.display === 'none') {
          advancedFilters.style.display = 'flex';
          toggleBtn.innerHTML = '<i class="fas fa-chevron-up"></i> إخفاء الخيارات';
        } else {
          advancedFilters.style.display = 'none';
          toggleBtn.innerHTML = '<i class="fas fa-sliders-h"></i> خيارات متقدمة';
        }
      });
    }

    // ========== 5. Focus glow on search form ==========
    const formCard = document.querySelector('.hero-search-form');
    searchInput.addEventListener('focus', () => formCard.classList.add('focused'));
    searchInput.addEventListener('blur', () => formCard.classList.remove('focused'));

    // ========== 6. Floating labels initialization ==========
    function initFloatingLabels() {
      document.querySelectorAll('.floating-wrapper select, .floating-wrapper input').forEach(field => {
        const wrapper = field.closest('.floating-wrapper');
        const label = wrapper.querySelector('.floating-label');
        if (!label) return;
        const update = () => {
          if (field.value && field.value !== '') label.classList.add('active');
          else label.classList.remove('active');
        };
        field.addEventListener('change', update);
        field.addEventListener('focus', () => label.classList.add('active'));
        field.addEventListener('blur', update);
        update();
      });
    }
    initFloatingLabels();

    // ========== 7. Active filter tags (display current params) ==========
    const tagsContainer = document.createElement('div');
    tagsContainer.id = 'filterTagsContainer';
    tagsContainer.className = 'active-filters-tags';
    // Insert after the hero section (or before categories)
    const heroSection = document.querySelector('.hero-section');
    heroSection.insertAdjacentElement('afterend', tagsContainer);

    function updateFilterTags() {
      const filters = [];
      if (categorySelect.value) {
        const text = categorySelect.options[categorySelect.selectedIndex]?.text;
        if (text && text !== 'جميع الأقسام') filters.push({name: 'القسم', val: text});
      }
      if (citySelect.value) {
        const text = citySelect.options[citySelect.selectedIndex]?.text;
        if (text && text !== 'جميع المدن') filters.push({name: 'المدينة', val: text});
      }
      if (typeSelect.value) {
        const text = typeSelect.options[typeSelect.selectedIndex]?.text;
        if (text && text !== 'جميع الأنواع') filters.push({name: 'النوع', val: text});
      }
      if (minPrice.value) filters.push({name: 'السعر من', val: minPrice.value});
      if (maxPrice.value) filters.push({name: 'السعر إلى', val: maxPrice.value});
      if (filters.length === 0) {
        tagsContainer.innerHTML = '';
        return;
      }
      tagsContainer.innerHTML = filters.map(f => `
        <span class="filter-tag">
          ${f.name}: ${f.val}
          <i class="fas fa-times" data-filter="${f.name}"></i>
        </span>
      `).join('');
      // attach remove event
      document.querySelectorAll('#filterTagsContainer .filter-tag i').forEach(icon => {
        icon.addEventListener('click', (e) => {
          const filterName = icon.getAttribute('data-filter');
          if (filterName === 'القسم') categorySelect.value = '';
          if (filterName === 'المدينة') citySelect.value = '';
          if (filterName === 'النوع') typeSelect.value = '';
          if (filterName === 'السعر من') minPrice.value = '';
          if (filterName === 'السعر إلى') maxPrice.value = '';
          // trigger change events to update floating labels and re-submit?
          // We'll let the user manually search again, or auto-submit:
          updateFilterTags();
          // Optionally auto-submit the form:
          // searchForm.submit();
        });
      });
    }
    // monitor changes on all filters
    [categorySelect, citySelect, typeSelect, minPrice, maxPrice].forEach(el => {
      if (el) el.addEventListener('change', updateFilterTags);
    });
    updateFilterTags();

    // ========== 8. Reset all filters ==========
    if (resetLink) {
      resetLink.addEventListener('click', (e) => {
        e.preventDefault();
        // clear all form fields
        searchInput.value = '';
        categorySelect.value = '';
        citySelect.value = '';
        typeSelect.value = '';
        if (minPrice) minPrice.value = '';
        if (maxPrice) maxPrice.value = '';
        // trigger change events for floating labels and tags
        [categorySelect, citySelect, typeSelect, minPrice, maxPrice].forEach(f => {
          if (f) {
            const ev = new Event('change');
            f.dispatchEvent(ev);
          }
        });
        updateFilterTags();
        // optionally close advanced filters
        if (advancedFilters) advancedFilters.style.display = 'none';
        if (toggleBtn) toggleBtn.innerHTML = '<i class="fas fa-sliders-h"></i> خيارات متقدمة';
        // submit the form to reset search results
        searchForm.submit();
      });
    }
  })();
</script>
