          <ul class="dropdown-menu dropdown-menu-flag">
            <li style="text-align:right;">
              <%= link_to new_job_path, class: 'dropdown-item dropdown-item-flag' do %>
                <i class="fas fa-plus-circle ms-2 text-success"></i> إعلان وظيفة
              <% end %>
            </li>
