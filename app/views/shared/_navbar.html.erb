              <%= link_to wanted_listings_path, class: 'dropdown-item dropdown-item-flag' do %>
                <i class="fas fa-search ms-2 text-danger"></i> مطلوب
              <% end %>
            </li>
          </ul>
        </li>
      </ul>

      <!-- Search Form -->
      <%= form_tag search_path, method: :get, class: 'd-flex mx-auto search-form' do %>
        <div class="input-group search-group">
          <%= text_field_tag :q, params[:q], class: 'form-control search-input', placeholder: 'ابحث عن...' %>
          <button class="btn search-btn" type="submit">
            <i class="fas fa-search"></i>
          </button>
        </div>
      <% end %>

      <!-- User Menu -->
      <ul class="navbar-nav">
        <% if user_signed_in? %>
          <!-- Quick Add Button
          <li class="nav-item">
            <%= link_to new_listing_path, class: 'btn btn-new-listing' do %>
              <i class="fas fa-plus me-1"></i> جديد
            <% end %>
          </li> -->

          <!-- User Dropdown -->
