              <li><hr class="dropdown-divider"></li>
              <li><%= button_to destroy_user_session_path, method: :delete, class: 'dropdown-item dropdown-item-flag text-danger', form_class: 'd-inline' do %><i class="fas fa-sign-out-alt ms-2"></i> خروج<% end %></li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to new_user_session_path, class: 'btn btn-outline-light me-2' do %>
              <i class="fas fa-sign-in-alt ms-1"></i> دخول
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to new_user_registration_path, class: 'btn btn-register' do %>
              <i class="fas fa-user-plus me-1"></i> تسجيل
            <% end %>
          </li>
        <% end %>
