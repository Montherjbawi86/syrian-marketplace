<nav class="navbar navbar-expand-lg fixed-top navbar-flag">
  <div class="container">
    <%= link_to root_path, class: 'navbar-brand' do %>
      <i class="fas fa-store ms-2"></i>
      <span class="brand-text">السوق السوري</span>
    <% end %>

    <button class="navbar-toggler toggler-flag" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <!-- Main Navigation - Shortened -->
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <%= link_to root_path, class: 'nav-link nav-link-flag' do %>
            <i class="fas fa-home ms-1"></i> الرئيسية
          <% end %>
        </li>
      <li class="nav-item">
     <%= link_to jobs_path, class: 'nav-link nav-link-flag' do %>
     <i class="fas fa-briefcase ms-1"></i> وظائف
     <% end %>
     </li>
        <!-- Categories Dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle nav-link-flag" href="#" role="button" data-bs-toggle="dropdown">
            <i class="fas fa-th-large ms-1"></i> الأقسام
          </a>
          <ul class="dropdown-menu dropdown-menu-flag">
            <% Category.active.limit(8).each do |category| %>
              <li style="text-align: center;">
                <%= link_to category_path(category), class: 'dropdown-item dropdown-item-flag' do %>
                  <i class="fas <%= category.icon_class %> ms-2 category-icon"></i>
                  <%= category.name_ar %>
                <% end %>
              </li>
            <% end %>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= link_to categories_path, class: 'dropdown-item dropdown-item-flag all-categories' do %>
