          <li><hr class="dropdown-divider"></li>

            <%= link_to new_listing_path, class: 'dropdown-item dropdown-item-flag' do%>
              <i class="fas fa-plus me-1"></i> نشر إعلان منتج
            <% end %>

            <li><hr class="dropdown-divider"></li>
            <li style="text-align:right;">
              <%= link_to for_sale_listings_path, class: 'dropdown-item dropdown-item-flag' do %>
