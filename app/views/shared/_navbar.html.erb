              <% end %>
            </li>
          </ul>
        </li>

        <!-- Consolidated Listings Dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle nav-link-flag" href="#" role="button" data-bs-toggle="dropdown">
            <i class="fas fa-tags ms-1"></i> الإعلانات
