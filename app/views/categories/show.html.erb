<!-- app/views/categories/show.html.erb -->
<div class="container py-4">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "الرئيسية", root_path %></li>
      <li class="breadcrumb-item"><%= link_to "التصنيفات", categories_path %></li>
      <li class="breadcrumb-item active"><%= @category.name_ar %></li>
    </ol>
  </nav>

  <div class="text-center mb-5">
    <div class="category-icon-wrapper bg-success bg-opacity-10 d-inline-flex p-4 rounded-circle mb-4">
      <i class="fas <%= @category.icon %> fa-4x" style="color: #006400;"></i>
    </div>
    <h1 class="display-4 fw-bold mb-3"><%= @category.name_ar %></h1>
    <p class="lead text-muted">
      <%= @subcategories.count %> تصنيفات فرعية | <%= @category.listings.count %> إعلان
    </p>
  </div>

  <% if @subcategories.any? %>
    <div class="row g-4">
      <% @subcategories.each do |subcategory| %>
        <div class="col-md-6 col-lg-4 col-xl-3">
          <%= link_to subcategory_path(subcategory), class: "text-decoration-none" do %>
            <div class="card subcategory-card h-100 shadow-sm border-0 text-center">
              <div class="card-body p-4">
                <i class="fas fa-folder-open fa-3x" style="color: #006400; margin-bottom: 1rem;"></i>
                <h5 class="card-title mb-2"><%= subcategory.name_ar %></h5>
                <p class="card-text text-muted"><%= subcategory.listings.count %> إعلان</p>
                <span class="btn btn-outline-success btn-sm mt-2">عرض التفاصيل</span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <i class="fas fa-folder-open fa-5x text-muted mb-4"></i>
      <h3 class="text-muted mb-3">لا توجد تصنيفات فرعية</h3>
    </div>
  <% end %>
</div>


