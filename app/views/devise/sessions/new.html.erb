<h2 class="text-center mb-4">تسجيل الدخول</h2>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.label :email, 'البريد الإلكتروني', class: 'form-label' %>
            <%= f.email_field :email, class: 'form-control', autofocus: true %>
          </div>
          <div class="mb-3">
            <%= f.label :password, 'كلمة المرور', class: 'form-label' %>
            <%= f.password_field :password, class: 'form-control' %>
          </div>
          <%= f.submit 'دخول', class: 'btn btn-primary w-100' %>
        <% end %>
        <div class="mt-3 text-center"><%= render "devise/shared/links" %></div>
      </div>
    </div>
  </div>
</div>
