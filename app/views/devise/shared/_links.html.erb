<%- if controller_name != 'sessions' %>
  <%= link_to 'تسجيل الدخول', new_session_path(resource_name) %><br>
<% end %>
<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to 'تسجيل جديد', new_registration_path(resource_name) %><br>
<% end %>
<%- if devise_mapping.recoverable? && controller_name != 'passwords' %>
  <%= link_to 'نسيت كلمة المرور؟', new_password_path(resource_name) %><br>
<% end %>
