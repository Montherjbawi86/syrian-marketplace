<!-- Breadcrumb -->
<div class="container-fluid bg-light py-3 mb-4">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
          <%= link_to root_path do %>
            <i class="fas fa-home"></i> الرئيسية
          <% end %>
        </li>
        <li class="breadcrumb-item">
          <%= link_to categories_path do %>
            التصنيفات
          <% end %>
        </li>
        <li class="breadcrumb-item active">جميع الأقسام الفرعية</li>
      </ol>
    </nav>
  </div>
</div>

<!-- Header -->
<div class="container mb-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h1 class="display-5 fw-bold mb-2">جميع الأقسام الفرعية</h1>
      <p class="lead text-muted">
        <i class="fas fa-th-large ms-2"></i> <%= @subcategories.total_count %> قسم فرعي
      </p>
    </div>
    <div>
      <%= link_to new_listing_path, class: "btn btn-primary btn-lg" do %>
        <i class="fas fa-plus-circle me-2"></i> إعلان جديد
      <% end %>
    </div>
  </div>
</div>

<!-- Filters -->
<div class="container mb-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <%= form_tag subcategories_path, method: :get, class: "row g-3" do %>
        <div class="col-md-4">
          <%= label_tag :category_id, "التصنيف الرئيسي", class: "form-label fw-bold" %>
          <%= select_tag :category_id, 
              options_from_collection_for_select(@categories, :id, :name_ar, params[:category_id], include_blank: 'جميع التصنيفات'),
              class: "form-select", 
              onchange: "this.form.submit()" %>
        </div>
        
        <div class="col-md-6">
          <%= label_tag :q, "بحث", class: "form-label fw-bold" %>
          <div class="input-group">
            <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "ابحث عن قسم..." %>
            <%= submit_tag "بحث", class: "btn btn-primary" %>
          </div>
        </div>
        
        <div class="col-md-2 d-flex align-items-end">
          <%= link_to "إلغاء الفلتر", subcategories_path, class: "btn btn-outline-secondary w-100" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Subcategory Cards Grid -->
<div class="container">
  <% if @subcategories.any? %>
    <div class="row g-4">
      <% @subcategories.each do |subcategory| %>
        <div class="col-md-6 col-lg-4 col-xl-3">
          <%= link_to subcategory_path(subcategory), class: "text-decoration-none" do %>
            <div class="card subcategory-card h-100 shadow-sm border-0">
              <div class="card-body p-4">
                <div class="subcategory-icon-wrapper mb-3 text-center">
                  <i class="fas <%= subcategory.icon_class || 'fa-folder' %> fa-3x text-primary"></i>
                </div>
                <h5 class="card-title text-center mb-2"><%= subcategory.name_ar %></h5>
                <p class="card-text text-muted text-center small mb-2">
                  <i class="fas fa-building me-1"></i>
                  <%= subcategory.category&.name_ar || 'بدون تصنيف' %>
                </p>
                <p class="card-text text-muted text-center">
                  <i class="fas fa-tag me-1"></i>
                  <%= subcategory.listings.count %> إعلان
                </p>
                <div class="mt-3 text-center">
                  <span class="btn btn-outline-primary btn-sm">
                    عرض التفاصيل <i class="fas fa-arrow-left me-1"></i>
                  </span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <!-- Pagination -->
    <div class="mt-5 d-flex justify-content-center">
      <%= paginate @subcategories, theme: 'bootstrap-5' %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <i class="fas fa-folder-open fa-5x text-muted mb-4"></i>
      <h3 class="text-muted mb-3">لا توجد أقسام فرعية</h3>
      <p class="lead text-muted">لم يتم إضافة أقسام فرعية بعد</p>
    </div>
  <% end %>
</div>
