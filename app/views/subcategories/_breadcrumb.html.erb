    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
          <%= link_to root_path do %>
            <i class="fas fa-home"></i> الرئيسية
          <% end %>
        </li>
        <li class="breadcrumb-item">
          <%= link_to categories_path do %>التصنيفات<% end %>
