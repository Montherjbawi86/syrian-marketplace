<div class="container mb-4">
  <div class="row g-3">
    <div class="col-md-3">
      <div class="card bg-primary text-white text-center border-0 shadow-sm">
        <div class="card-body">
          <i class="fas fa-chart-line fa-2x mb-2"></i>
          <h3 class="mb-0"><%= @listings.total_count %></h3>
          <p class="mb-0">إجمالي الإعلانات</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white text-center border-0 shadow-sm">
        <div class="card-body">
          <i class="fas fa-tag fa-2x mb-2"></i>
          <h3 class="mb-0"><%= @listings.where(listing_type: 'sell').count %></h3>
          <p class="mb-0">للبيع</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white text-center border-0 shadow-sm">
        <div class="card-body">
          <i class="fas fa-key fa-2x mb-2"></i>
          <h3 class="mb-0"><%= @listings.where(listing_type: 'rent').count %></h3>
          <p class="mb-0">للإيجار</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-dark text-center border-0 shadow-sm">
        <div class="card-body">
          <i class="fas fa-city fa-2x mb-2"></i>
          <h3 class="mb-0"><%= @listings.select(:city_id).distinct.count %></h3>
          <p class="mb-0">مدن</p>
        </div>
      </div>
    </div>
  </div>
</div>
