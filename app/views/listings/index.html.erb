<%# app/views/listings/index.html.erb %>
<%# Redesigned with green theme, grid/list toggle, and images restored %>



<!-- Header -->
<div class="listings-header">
  <h1 class="listings-title"><%= @title || 'جميع الإعلانات' %></h1>
  <% if user_signed_in? %>
    <%= link_to new_listing_path, class: 'btn btn-primary add-listing-btn' do %>
      <i class="fas fa-plus"></i> إعلان جديد
    <% end %>
  <% end %>
</div>

<!-- Results count & view toggle -->
<div class="results-bar">
  <div class="results-count">
    <span><%= @listings.total_count %></span> إعلان
  </div>
  <div class="view-toggle">
    <button class="view-toggle-btn active" id="gridViewBtn" aria-label="عرض شبكي">
      <i class="fas fa-th"></i>
    </button>
    <button class="view-toggle-btn" id="listViewBtn" aria-label="عرض قائمة">
      <i class="fas fa-list"></i>
    </button>
  </div>
</div>

<!-- Grid View Container -->
<div id="gridViewContainer">
  <% if @listings.present? %>
    <div class="row g-4">
      <% @listings.each do |listing| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0 listing-card fade-up">
            <!-- Image Section -->
            <div class="listing-card-image">
              <% if listing.images.attached? && listing.images.any? %>
                <%= image_tag listing.images.first, class: 'card-img-top', style: 'height: 180px; width: 100%; object-fit: cover;' %>
              <% else %>
                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                  <i class="fas fa-image fa-3x text-muted"></i>
                </div>
              <% end %>
            </div>

            <div class="card-body">
              <!-- Title & Type Badge -->
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title mb-0">
                  <%= link_to listing.title_ar.presence || listing.title, listing_path(listing), class: 'text-decoration-none text-dark listing-title' %>
                </h5>
                <span class="badge bg-info">
                  <i class="fas <%= listing.listing_type == 'job' ? 'fa-briefcase' : 'fa-tag' %> me-1"></i>
                  <%= listing.listing_type_display %>
                </span>
              </div>

              <!-- User/Company & Location -->
              <p class="text-muted small mb-2">
                <i class="fas fa-user me-1"></i> <%= listing.user&.name %>
                <i class="fas fa-map-marker-alt ms-2 me-1"></i> <%= listing.city&.name_ar || 'غير محدد' %>
              </p>

              <!-- Extra meta (skills, deadline, condition) -->
              <div class="listing-meta-icons mb-2">
                <% if listing.listing_type == 'job' %>
                  <% if listing.experience_level.present? %>
                    <span><i class="fas fa-chart-line"></i> <%= listing.experience_level.humanize %></span>
                  <% end %>
                  <% if listing.skills.present? %>
                    <span><i class="fas fa-code"></i> <%= listing.skills.split(',').count %> مهارة</span>
                  <% end %>
                  <% if listing.deadline.present? %>
                    <% days_left = (listing.deadline - Date.today).to_i %>
                    <span class="deadline-badge <%= 'soon' if days_left <= 3 && days_left >= 0 %> <%= 'normal' if days_left > 3 %>">
                      <i class="far fa-calendar-alt"></i>
                      <% if days_left < 0 %>انتهت<% elsif days_left == 0 %>آخر اليوم<% else %>متبقي <%= days_left %> يوم<% end %>
                    </span>
                  <% end %>
                <% else %>
                  <% if listing.condition.present? %>
                    <span><i class="fas fa-info-circle"></i> <%= listing.condition.humanize %></span>
                  <% end %>
                <% end %>
              </div>

              <!-- Short description -->
              <p class="card-text small text-secondary mb-3">
                <%= truncate(strip_tags(listing.description_ar.presence || listing.description), length: 90) %>
              </p>

              <!-- Price & Details button -->
              <div class="d-flex justify-content-between align-items-center mt-auto">
                <span class="text-success fw-bold">
                  <%= listing.formatted_price %>
                </span>
                <%= link_to 'تفاصيل', listing_path(listing), class: 'btn btn-sm btn-outline-primary rounded-pill' %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="pagination-wrapper">
      <%= paginate @listings %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-content">
        <i class="fas fa-box-open empty-icon"></i>
        <h3 class="empty-title">لا توجد إعلانات</h3>
        <p class="empty-text">كن أول من يضيف إعلان!</p>
        <% if user_signed_in? %>
          <%= link_to new_listing_path, class: 'btn btn-primary' do %>
            <i class="fas fa-plus"></i> أضف إعلان
          <% end %>
        <% else %>
          <%= link_to new_user_session_path, class: 'btn btn-primary' do %>
            <i class="fas fa-sign-in-alt"></i> سجل دخول
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- List View Container (hidden by default) -->
<div id="listViewContainer" style="display: none;">
  <% if @listings.present? %>
    <div class="list-view">
      <% @listings.each do |listing| %>
        <%= link_to listing_path(listing), class: 'listing-item' do %>
          <div class="listing-image">
            <% if listing.images.attached? && listing.images.any? %>
              <%= image_tag listing.images.first, class: 'listing-image' %>
            <% else %>
              <i class="fas fa-image fa-2x text-muted"></i>
            <% end %>
          </div>
          <div class="listing-info">
            <h6 class="listing-title"><%= listing.title_ar.presence || listing.title %></h6>
            <div class="listing-meta">
              <span><i class="fas fa-map-marker-alt"></i> <%= listing.city&.name_ar || 'غير محدد' %></span>
              <span><i class="far fa-clock"></i> <%= time_ago_in_words(listing.created_at) %></span>
            </div>
          </div>
          <span class="listing-price"><%= listing.formatted_price %></span>
        <% end %>
      <% end %>
    </div>

    <div class="pagination-wrapper">
      <%= paginate @listings %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const gridBtn = document.getElementById('gridViewBtn');
    const listBtn = document.getElementById('listViewBtn');
    const gridContainer = document.getElementById('gridViewContainer');
    const listContainer = document.getElementById('listViewContainer');

    function setView(view) {
      if (view === 'grid') {
        gridContainer.style.display = 'block';
        listContainer.style.display = 'none';
        gridBtn.classList.add('active');
        listBtn.classList.remove('active');
        localStorage.setItem('listingsView', 'grid');
      } else {
        gridContainer.style.display = 'none';
        listContainer.style.display = 'block';
        listBtn.classList.add('active');
        gridBtn.classList.remove('active');
        localStorage.setItem('listingsView', 'list');
      }
    }

    const savedView = localStorage.getItem('listingsView');
    if (savedView === 'list') {
      setView('list');
    } else {
      setView('grid');
    }

    gridBtn.addEventListener('click', () => setView('grid'));
    listBtn.addEventListener('click', () => setView('list'));
  });
</script>
